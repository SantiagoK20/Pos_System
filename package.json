
{
  "name": "pos-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node -e \"require('node:fs').mkdirSync('php/opcache-cache', { recursive: true })\"",
    "dev": "concurrently -k -n backend,frontend \"php\\php.exe -d opcache.file_cache=\\\"%CD%\\php\\opcache-cache\\\" -d opcache.file_cache_fallback=1 -S 127.0.0.1:8001 -t laravel-backend\\public laravel-backend\\public\\index.php\" \"vite\"",
    "dev:full": "npm run dev",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.5",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.ateclesgrill.pos",
    "productName": "Atecles Grill POS",
    "asar": true,
    "asarUnpack": [
      "php/**/*",
      "laravel-backend/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "php",
        "to": "php",
        "filter": [
          "**/*",
          "cacert.pem"
        ]
      },
      {
        "from": "laravel-backend",
        "to": "laravel-backend",
        "filter": [
          "**/*",
          ".env",
          "storage/firebase-credentials.json",
          "!**/tests/**",
          "!**/.git/**"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.5": true
  }
}
